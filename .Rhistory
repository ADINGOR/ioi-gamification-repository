if (!is.null(input$registro) && input$registro != "Todos") {
df <- df %>% filter(registro == input$registro)
}
# solo URL
if (isTRUE(input$solo_url)) {
df <- df %>% filter(!is.na(url), url != "")
}
df %>% arrange(nombre)
})
output$n_resultados <- renderText({
paste("Resultados:", nrow(datos_filtrados()))
})
output$tabla_juegos <- renderDT({
df <- datos_filtrados() %>%
transmute(
Detalle = sprintf(
"<a href='#' onclick=\"Shiny.setInputValue('ver_juego_id', '%s', {priority: 'event'}); return false;\">Ver ficha</a>",
id_juego
),
Nombre = nombre,
Asignaturas = asignaturas,
Keywords = keywords,
Idioma = idioma,
Ámbito = ambito,
Empresa = nombre_empresa,
Precio = precio,
Registro = registro
)
datatable(
df,
escape = FALSE,
rownames = FALSE,
selection = "none",
options = list(
pageLength = 10,
autoWidth = TRUE,
scrollX = TRUE
)
)
})
observeEvent(input$ver_juego_id, {
req(input$ver_juego_id)
juego <- juegos_full %>%
filter(id_juego == input$ver_juego_id)
req(nrow(juego) > 0)
juego <- juego[1, ]
video_embed <- extraer_youtube_embed(juego$videos)
showModal(
modalDialog(
title = juego$nombre,
size = "l",
easyClose = TRUE,
footer = modalButton("Cerrar"),
tags$p(tags$strong("Asignaturas: "), juego$asignaturas),
tags$p(tags$strong("Keywords: "), juego$keywords),
tags$p(tags$strong("Idioma: "), juego$idioma),
tags$p(tags$strong("Ámbito: "), juego$ambito),
tags$p(tags$strong("Empresa: "), juego$nombre_empresa),
tags$p(tags$strong("Precio: "), juego$precio),
tags$p(tags$strong("Registro: "), juego$registro),
if (!is.na(juego$descripcion) && juego$descripcion != "") {
tagList(
tags$h4("Descripción"),
tags$p(juego$descripcion)
)
},
if (!is.na(juego$url) && juego$url != "") {
tagList(
tags$h4("Acceso"),
tags$p(
tags$a(
href = juego$url,
target = "_blank",
"Abrir recurso"
)
)
)
},
if (!is.null(video_embed)) {
tagList(
tags$h4("Vídeo"),
tags$div(
style = "position:relative;padding-bottom:56.25%;height:0;overflow:hidden;",
tags$iframe(
src = video_embed,
style = "position:absolute;top:0;left:0;width:100%;height:100%;",
frameborder = "0",
allowfullscreen = NA
)
)
)
} else if (!is.na(juego$videos) && juego$videos != "") {
tagList(
tags$h4("Vídeo / recurso multimedia"),
tags$p(
tags$a(
href = juego$videos,
target = "_blank",
"Abrir vídeo"
)
)
)
}
)
)
})
}
#--------------------------------------------------
# 6. Lanzar app
#--------------------------------------------------
shinyApp(ui = ui, server = server)
runApp()
shiny::runApp()
library(shiny)
library(tidyverse)
library(readr)
library(DT)
library(bslib)
library(stringr)
library(htmltools)
#--------------------------------------------------
# 1. Cargar datos
#--------------------------------------------------
juegos <- read_csv("data_clean/juegos.csv", show_col_types = FALSE)
juegos_asignaturas <- read_csv("data_clean/juegos_asignaturas.csv", show_col_types = FALSE)
juegos_keywords <- read_csv("data_clean/juegos_keywords.csv", show_col_types = FALSE)
#--------------------------------------------------
# 2. Funciones auxiliares
#--------------------------------------------------
texto_a_buscar <- function(x) {
x %>%
replace_na("") %>%
str_to_lower()
}
colapsar_unicos <- function(x) {
x %>%
unique() %>%
discard(~ is.na(.) || . == "") %>%
sort() %>%
paste(collapse = ", ")
}
extraer_youtube_embed <- function(url) {
if (is.na(url) || url == "") return(NULL)
if (str_detect(url, "youtube\\.com/watch\\?v=")) {
id <- str_match(url, "v=([^&]+)")[, 2]
if (!is.na(id)) return(paste0("https://www.youtube.com/embed/", id))
}
if (str_detect(url, "youtu\\.be/")) {
id <- str_match(url, "youtu\\.be/([^?&]+)")[, 2]
if (!is.na(id)) return(paste0("https://www.youtube.com/embed/", id))
}
if (str_detect(url, "youtube\\.com/embed/")) {
return(url)
}
NULL
}
# Divide cadenas del tipo "Español, Inglés" en filas separadas
separar_valores <- function(df, col) {
df %>%
select(id_juego, {{ col }}) %>%
filter(!is.na({{ col }}), {{ col }} != "") %>%
separate_rows({{ col }}, sep = "\\s*,\\s*") %>%
mutate({{ col }} := str_trim({{ col }})) %>%
filter({{ col }} != "") %>%
distinct()
}
#--------------------------------------------------
# 3. Preparar tablas auxiliares
#--------------------------------------------------
# Asignaturas agregadas por juego
asignaturas_por_juego <- juegos_asignaturas %>%
group_by(id_juego) %>%
summarise(asignaturas = colapsar_unicos(asignatura), .groups = "drop")
# Keywords agregadas por juego
keywords_por_juego <- juegos_keywords %>%
group_by(id_juego) %>%
summarise(keywords = colapsar_unicos(keyword), .groups = "drop")
# Idiomas separados a nivel individual
juegos_idiomas <- separar_valores(juegos, idioma) %>%
rename(idioma_individual = idioma)
idiomas_disponibles <- juegos_idiomas %>%
distinct(idioma_individual) %>%
arrange(idioma_individual) %>%
pull(idioma_individual)
# Tabla consolidada
juegos_full <- juegos %>%
left_join(asignaturas_por_juego, by = "id_juego") %>%
left_join(keywords_por_juego, by = "id_juego") %>%
mutate(
asignaturas = replace_na(asignaturas, ""),
keywords = replace_na(keywords, ""),
ficha_pdf = replace_na(ficha_pdf, ""),
tiene_ficha = ficha_pdf != "",
texto_busqueda = paste(
nombre, descripcion, nombre_empresa, idioma, ambito,
precio, registro, asignaturas, keywords,
sep = " "
) %>% texto_a_buscar()
)
#--------------------------------------------------
# 4. UI
#--------------------------------------------------
ui <- page_navbar(
title = "Juegos de gamificación para IOI",
theme = bs_theme(version = 5, bootswatch = "flatly"),
nav_panel(
"Inicio",
fluidPage(
br(),
card(
card_header("Catálogo de juegos de gamificación para Ingeniería de Organización Industrial"),
card_body(
p("Esta aplicación permite explorar un catálogo de juegos y recursos de gamificación aplicables a asignaturas de Ingeniería de Organización Industrial (IOI)."),
p("El buscador permite filtrar los recursos por asignatura, keyword, idioma o necesidad de registro, así como realizar búsquedas por texto libre en nombre, descripción o temática del juego."),
p("El objetivo es facilitar el acceso a materiales docentes que permitan incorporar dinámicas de aprendizaje activo y gamificación en asignaturas del ámbito de la organización industrial."),
p("Algunos juegos incluyen además una ficha avanzada en PDF con información docente más detallada sobre su uso, objetivos de aprendizaje y posibles formas de implementación en el aula.")
)
),
br(),
card(
card_header("Asistente GPT para gamificación"),
card_body(
p("Además de este repositorio, se ha desarrollado un asistente basado en GPT entrenado con esta base de datos de juegos y con artículos adicionales sobre gamificación en IOI."),
p("Este asistente puede ayudar a proponer dinámicas docentes, sugerir juegos adecuados para determinadas asignaturas o actividades de aprendizaje, o inspirar nuevas ideas de gamificación."),
tags$p(
"Puedes probarlo aquí: ",
tags$a(
href = "https://chatgpt.com/g/g-H7fZGRAt5-aprendizaje-interactivo-en-ing-de-organizacion",
target = "_blank",
"Aprendizaje interactivo en Ingeniería de Organización"
)
)
)
),
br(),
card(
card_header("Origen de la base de datos"),
card_body(
p("La base de datos de juegos utilizada en esta aplicación forma parte de un repositorio docente desarrollado para apoyar el uso de la gamificación en el aula."),
tags$p(
"La explicación detallada de la creación de este repositorio puede consultarse en: ",
tags$a(
href = "https://epsapps.udg.edu/cioblog/index.php/2019/12/13/repositorio-de-juegos-para-el-aula/",
target = "_blank",
"Repositorio de juegos para el aula"
)
)
)
),
br(),
card(
card_header("Desarrollo de la aplicación"),
card_body(
p("Esta aplicación ha sido desarrollada por la ",
tags$a(
href = "https://adingor.net/comision-coordinacion-docente/",
target = "_blank",
"Comisión de Coordinación Docente de ADINGOR"
),
" a partir del trabajo realizado en un Trabajo Fin de Grado desarrollado en el seno del ",
tags$a(
href = "https://www.insisoc.uva.es/",
target = "_blank",
"grupo INSISOC de la Universidad de Valladolid"
),
"."
),
tags$p(
"El código fuente de la aplicación y la base de datos están disponibles en GitHub: ",
tags$a(
href = "https://github.com/ADINGOR/ioi-gamification-repository",
target = "_blank",
"Repositorio de código"
)
)
)
),
br(),
card(
card_header("Colaboración y mejoras"),
card_body(
p("Este repositorio está abierto a ampliaciones y mejoras. Si conoces juegos adicionales, deseas proponer modificaciones o detectar algún error, no dudes en contactar."),
tags$p(
"Contacto: ",
tags$a(
href = "mailto:jmgalan@ubu.es",
"José Manuel Galán"
),
" o cualquier otro miembro de la ",
tags$a(
href = "https://adingor.net/comision-coordinacion-docente/",
target = "_blank",
"Comisión de Coordinación Docente de ADINGOR"
)
),
p("También puedes contribuir directamente mediante un pull request en el repositorio de GitHub de la aplicación.")
)
)
)
),
nav_panel(
"Buscador",
sidebarLayout(
sidebarPanel(
width = 3,
textInput(
"busqueda",
"Búsqueda libre",
placeholder = "Nombre, descripción, keyword, empresa..."
),
selectInput(
"asignatura",
"Asignatura",
choices = c("Todas", sort(unique(juegos_asignaturas$asignatura))),
selected = "Todas"
),
selectInput(
"keyword",
"Keyword",
choices = c("Todas", sort(unique(juegos_keywords$keyword))),
selected = "Todas"
),
selectInput(
"idioma",
"Idioma",
choices = c("Todos", idiomas_disponibles),
selected = "Todos"
),
selectInput(
"registro",
"Registro",
choices = c("Todos", sort(unique(na.omit(juegos$registro)))),
selected = "Todos"
),
checkboxInput("solo_url", "Solo juegos con URL", value = FALSE),
checkboxInput("solo_ficha", "Solo juegos con ficha avanzada", value = FALSE),
br(),
strong(textOutput("n_resultados"))
),
mainPanel(
width = 9,
DTOutput("tabla_juegos")
)
)
)
)
#--------------------------------------------------
# 5. Server
#--------------------------------------------------
server <- function(input, output, session) {
datos_filtrados <- reactive({
df <- juegos_full
# búsqueda libre
if (!is.null(input$busqueda) && str_trim(input$busqueda) != "") {
patron <- str_to_lower(str_trim(input$busqueda))
df <- df %>%
filter(str_detect(texto_busqueda, fixed(patron)))
}
# asignatura
if (!is.null(input$asignatura) && input$asignatura != "Todas") {
ids_asignatura <- juegos_asignaturas %>%
filter(asignatura == input$asignatura) %>%
pull(id_juego) %>%
unique()
df <- df %>% filter(id_juego %in% ids_asignatura)
}
# keyword
if (!is.null(input$keyword) && input$keyword != "Todas") {
ids_keyword <- juegos_keywords %>%
filter(keyword == input$keyword) %>%
pull(id_juego) %>%
unique()
df <- df %>% filter(id_juego %in% ids_keyword)
}
# idioma individual
if (!is.null(input$idioma) && input$idioma != "Todos") {
ids_idioma <- juegos_idiomas %>%
filter(idioma_individual == input$idioma) %>%
pull(id_juego) %>%
unique()
df <- df %>% filter(id_juego %in% ids_idioma)
}
# registro
if (!is.null(input$registro) && input$registro != "Todos") {
df <- df %>% filter(registro == input$registro)
}
# solo URL
if (isTRUE(input$solo_url)) {
df <- df %>% filter(!is.na(url), url != "")
}
# solo ficha avanzada
if (isTRUE(input$solo_ficha)) {
df <- df %>% filter(tiene_ficha)
}
df %>% arrange(nombre)
})
output$n_resultados <- renderText({
paste("Resultados:", nrow(datos_filtrados()))
})
output$tabla_juegos <- renderDT({
df <- datos_filtrados() %>%
transmute(
Detalle = sprintf(
"<a href='#' onclick=\"Shiny.setInputValue('ver_juego_id', '%s', {priority: 'event'}); return false;\">Ver ficha</a>",
id_juego
),
Nombre = nombre,
Asignaturas = asignaturas,
Keywords = keywords,
Idioma = idioma,
Ámbito = ambito,
Empresa = nombre_empresa,
Precio = precio,
Registro = registro,
`Ficha avanzada` = ifelse(tiene_ficha, "Sí", "No")
)
datatable(
df,
escape = FALSE,
rownames = FALSE,
selection = "none",
options = list(
pageLength = 10,
autoWidth = TRUE,
scrollX = TRUE
)
)
})
observeEvent(input$ver_juego_id, {
req(input$ver_juego_id)
juego <- juegos_full %>%
filter(id_juego == input$ver_juego_id)
req(nrow(juego) > 0)
juego <- juego[1, ]
video_embed <- extraer_youtube_embed(juego$videos)
showModal(
modalDialog(
title = juego$nombre,
size = "l",
easyClose = TRUE,
footer = modalButton("Cerrar"),
tags$p(tags$strong("Asignaturas: "), juego$asignaturas),
tags$p(tags$strong("Keywords: "), juego$keywords),
tags$p(tags$strong("Idioma: "), juego$idioma),
tags$p(tags$strong("Ámbito: "), juego$ambito),
tags$p(tags$strong("Empresa: "), juego$nombre_empresa),
tags$p(tags$strong("Precio: "), juego$precio),
tags$p(tags$strong("Registro: "), juego$registro),
tags$p(tags$strong("Ficha avanzada disponible: "), ifelse(juego$tiene_ficha, "Sí", "No")),
if (!is.na(juego$descripcion) && juego$descripcion != "") {
tagList(
tags$h4("Descripción"),
tags$p(juego$descripcion)
)
},
if (juego$tiene_ficha) {
tagList(
tags$h4("Ficha docente avanzada"),
tags$p(
tags$a(
href = juego$ficha_pdf,
target = "_blank",
"Abrir ficha en PDF"
)
)
)
},
if (!is.na(juego$url) && juego$url != "") {
tagList(
tags$h4("Acceso"),
tags$p(
tags$a(
href = juego$url,
target = "_blank",
"Abrir recurso"
)
)
)
},
if (!is.null(video_embed)) {
tagList(
tags$h4("Vídeo"),
tags$div(
style = "position:relative;padding-bottom:56.25%;height:0;overflow:hidden;",
tags$iframe(
src = video_embed,
style = "position:absolute;top:0;left:0;width:100%;height:100%;",
frameborder = "0",
allowfullscreen = NA
)
)
)
} else if (!is.na(juego$videos) && juego$videos != "") {
tagList(
tags$h4("Vídeo / recurso multimedia"),
tags$p(
tags$a(
href = juego$videos,
target = "_blank",
"Abrir vídeo"
)
)
)
}
)
)
})
}
#--------------------------------------------------
# 6. Lanzar app
#--------------------------------------------------
shinyApp(ui = ui, server = server)
